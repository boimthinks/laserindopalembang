---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Schema from '../components/Schema.astro';
import { faqGeneral } from '../data/faq';
---

<BaseLayout
  title="FAQ Laser Cutting Palembang"
  description="Pertanyaan seputar jasa laser cutting Palembang. Harga, material, motif, proses pengerjaan, garansi, dan cara pemesanan."
  breadcrumbs={[{ name: 'Beranda', slug: '/' }, { name: 'FAQ', slug: '/faq' }]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-white mt-2">Pertanyaan Umum (FAQ)</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">
          Semua yang perlu Anda tahu tentang jasa laser cutting di Palembang. Dari harga, material, motif, hingga proses pemesanan.
        </p>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <Schema type="FAQPage" data={{ questions: faqGeneral }} />
      
      <div class="space-y-4">
        {faqGeneral.map((item, i) => (
          <details class="group bg-brand-surface-alt rounded-xl border border-zinc-800 open:border-brand-primary/30 open:ring-1 open:ring-brand-primary/10 transition-all">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
              <span class="text-sm font-medium text-white pr-4">{item.question}</span>
              <svg class="w-4 h-4 text-zinc-500 shrink-0 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-4">
              <p class="text-sm text-zinc-400 leading-relaxed">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="mt-16">
        <CTABanner />
      </div>
    </div>
  </div>
</BaseLayout>
