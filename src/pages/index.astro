---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE } from '../config/site';
import { services } from '../data/services';
import { motifs } from '../data/motifs';
import { waUrl, slugifyMotif, motifImagePath } from '../lib/utils';
import { getCollection } from 'astro:content';

function parseIndoDate(dateStr: string): number {
  const months: Record<string, string> = {
    Januari: '01', Februari: '02', Maret: '03', April: '04',
    Mei: '05', Juni: '06', Juli: '07', Agustus: '08',
    September: '09', Oktober: '10', November: '11', Desember: '12'
  };
  const parts = dateStr.split(' ');
  const day = parts[0].padStart(2, '0');
  const month = months[parts[1]] || '01';
  const year = parts[2];
  return new Date(`${year}-${month}-${day}`).getTime();
}

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts
  .sort((a, b) => parseIndoDate(b.data.date) - parseIndoDate(a.data.date))
  .slice(0, 6);

const motifImageMap: Record<string, string> = {
  'Geometris Minimalis': '/img/motif/pagar-geometris-minimalis.webp',
  'Floral Modern': '/img/motif/pagar-floral-modern.webp',
  'Kaligrafi / Islami': '/img/motif/pagar-kaligrafi-islami.webp',
  'Hexagon / Sarang Lebah': '/img/motif/fasad-hexagon-sarang-lebah.webp',
  'Pohon Ranting': '/img/motif/pagar-pohon-ranting.webp',
  'Moroccan Pattern': '/img/motif/partisi-moroccan-pattern.webp',
  'Daun Tropis Lebar': '/img/motif/pagar-daun-tropis-lebar.webp',
  'Garis Vertikal Miring': '/img/motif/railing-garis-vertikal-miring.webp',
  'Mozaik Lingkaran': '/img/motif/partisi-mozaik-lingkaran.webp',
  'Batik Nusantara': '/img/motif/partisi-batik-nusantara.webp',
};

const motifServiceMap: Record<string, string> = {
  'Geometris Minimalis': 'pagar',
  'Floral Modern': 'pagar',
  'Kaligrafi / Islami': 'pagar',
  'Hexagon / Sarang Lebah': 'fasad',
  'Pohon Ranting': 'pagar',
  'Moroccan Pattern': 'partisi',
  'Daun Tropis Lebar': 'pagar',
  'Garis Vertikal Miring': 'railing',
  'Mozaik Lingkaran': 'partisi',
  'Batik Nusantara': 'partisi',
};

const topMotifs = motifs.slice(0, 10).map((m) => ({
  ...m,
  motifSlug: slugifyMotif(m.name),
  serviceSlug: motifServiceMap[m.name] || 'pagar',
  imagePath: motifImageMap[m.name] || `/img/motif/pagar-${slugifyMotif(m.name)}.webp`,
}));
---

<BaseLayout
  title="Jasa Laser Cutting Palembang — Presisi Fiber Laser, CNC Router & CO2"
  description="Jasa laser cutting Palembang presisi tinggi by Sriwijaya Grafika. Layanan potong plat besi, stainless, aluminium, ACP, MDF, dan akrilik dengan 3 mesin industri modern di Talang Jambe."
  schemaType="LocalBusiness"
  breadcrumbs={[{ name: 'Beranda', slug: '/' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 pb-36 md:pt-60 md:pb-48 overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <picture>
        <source srcset="/hero_laserindo_palembang_mobile.webp" media="(max-width: 768px)" />
        <img src="/hero_laserindo_palembang.webp" alt="Workshop Jasa Laser Cutting Palembang Sriwijaya Grafika" class="w-full h-full object-cover" aria-hidden="true" />
      </picture>
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 relative">
      <div class="max-w-3xl animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white text-xs font-semibold mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
          Laserindo by Sriwijaya Grafika — Sejak 2008
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight uppercase" style="font-family: 'Oxanium', sans-serif">
          Jasa Laser Cutting <span class="text-brand-accent">Palembang</span>
        </h1>
        <p class="text-lg text-zinc-200 mt-3 max-w-xl leading-relaxed">
          Pusat pemotongan presisi lembaran logam dan non-logam di Palembang dengan toleransi 0.1 mm. Didukung 3 lini mesin workshop: Fiber Laser Plat, CNC Router, dan Laser CO2.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-accent text-white font-semibold hover:bg-brand-accent-light transition-colors">
            Konsultasi & Hitung Biaya
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/harga" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
            Daftar Tarif Potong
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 animate-stagger">
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">3 Mesin</div>
          <div class="text-xs text-zinc-400 mt-1">Fiber, CNC & CO2</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">0.1 mm</div>
          <div class="text-xs text-zinc-400 mt-1">Toleransi Presisi</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.yearsExperience}+ Thn</div>
          <div class="text-xs text-zinc-400 mt-1">Sriwijaya Grafika</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">Free</div>
          <div class="text-xs text-zinc-400 mt-1">Review File & Nesting</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Armada Mesin Workshop -->
  <section class="py-20 border-b border-zinc-800/60">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Kapasitas Produksi</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">3 Mesin Pemotong Presisi di Workshop Kami</h2>
        <p class="text-zinc-400 mt-3">Setiap mesin dirancang khusus menangani jenis material tertentu dengan hasil potongan rapi, cepat, dan presisi tinggi.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Mesin 1: Fiber Laser -->
        <div class="bg-brand-surface-alt rounded-2xl border border-zinc-800 overflow-hidden hover:border-brand-primary/40 transition-all flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden relative bg-zinc-900">
            <img 
              src="/img/mesin-potong/mesin-potong-laser-fiber_poco.webp" 
              alt="Mesin Laser Fiber Plat Logam Sriwijaya Grafika Palembang" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
            />
            <span class="absolute top-3 left-3 w-8 h-8 rounded-lg bg-black/70 backdrop-blur-sm text-brand-primary font-bold flex items-center justify-center text-sm border border-white/10">
              01
            </span>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-white mb-2">Mesin Laser Fiber Plat</h3>
            <span class="inline-block self-start text-xs font-semibold text-brand-primary bg-brand-primary/10 px-2.5 py-1 rounded-full mb-3">
              Khusus Plat Logam (m²)
            </span>
            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              Menggunakan sinar laser serat optik berdaya tinggi untuk memotong lembaran plat logam tanpa gerinda kasar (burr-free).
            </p>
            <div class="border-t border-zinc-800 pt-4 space-y-2 text-xs text-zinc-300">
              <div class="flex justify-between"><span>Plat Besi & Galvanis:</span> <span class="font-medium text-white">0,6 – 12 mm</span></div>
              <div class="flex justify-between"><span>Stainless Steel:</span> <span class="font-medium text-white">0,6 – 3 mm</span></div>
              <div class="flex justify-between"><span>Aluminium:</span> <span class="font-medium text-white">0,6 – 3 mm</span></div>
              <div class="flex justify-between text-brand-primary font-semibold pt-1"><span>Tarif Jasa:</span> <span>Mulai Rp 200.000 / m²</span></div>
            </div>
          </div>
        </div>

        <!-- Mesin 2: CNC Router -->
        <div class="bg-brand-surface-alt rounded-2xl border border-zinc-800 overflow-hidden hover:border-brand-primary/40 transition-all flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden relative bg-zinc-900">
            <img 
              src="/img/mesin-potong/mesin-potong-CNC-router_poco.webp" 
              alt="Mesin CNC Router Lembaran ACP dan Kayu Sriwijaya Grafika Palembang" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
            />
            <span class="absolute top-3 left-3 w-8 h-8 rounded-lg bg-black/70 backdrop-blur-sm text-brand-primary font-bold flex items-center justify-center text-sm border border-white/10">
              02
            </span>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-white mb-2">Mesin CNC Router</h3>
            <span class="inline-block self-start text-xs font-semibold text-brand-primary bg-brand-primary/10 px-2.5 py-1 rounded-full mb-3">
              Kayu, Komposit & Panel (Keping)
            </span>
            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              Spindle putaran tinggi untuk memotong lembaran panel utuh ukuran standar 122 x 244 cm untuk kebutuhan interior dan fasad.
            </p>
            <div class="border-t border-zinc-800 pt-4 space-y-2 text-xs text-zinc-300">
              <div class="flex justify-between"><span>ACP (Aluminium Composite):</span> <span class="font-medium text-white">3 – 4 mm</span></div>
              <div class="flex justify-between"><span>Plywood (Multiplek):</span> <span class="font-medium text-white">3 – 20 mm</span></div>
              <div class="flex justify-between"><span>MDF / MHR & PVC Board:</span> <span class="font-medium text-white">3 – 20 mm</span></div>
              <div class="flex justify-between text-brand-primary font-semibold pt-1"><span>Tarif Jasa:</span> <span>Mulai Rp 200.000 / Keping</span></div>
            </div>
          </div>
        </div>

        <!-- Mesin 3: Laser CO2 -->
        <div class="bg-brand-surface-alt rounded-2xl border border-zinc-800 overflow-hidden hover:border-brand-primary/40 transition-all flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden relative bg-zinc-900">
            <img 
              src="/img/mesin-potong/mesin-potong-laser-CO2_poco.webp" 
              alt="Mesin Laser CO2 Akrilik Presisi Sriwijaya Grafika Palembang" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
            />
            <span class="absolute top-3 left-3 w-8 h-8 rounded-lg bg-black/70 backdrop-blur-sm text-brand-primary font-bold flex items-center justify-center text-sm border border-white/10">
              03
            </span>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-white mb-2">Mesin Laser CO2</h3>
            <span class="inline-block self-start text-xs font-semibold text-brand-primary bg-brand-primary/10 px-2.5 py-1 rounded-full mb-3">
              Khusus Akrilik Presisi (Menit)
            </span>
            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              Tabung sinar laser CO2 yang memberikan efek potongan tepi bening mengkilap (flame-polished) tanpa perlu amplas manual.
            </p>
            <div class="border-t border-zinc-800 pt-4 space-y-2 text-xs text-zinc-300">
              <div class="flex justify-between"><span>Ketebalan Akrilik:</span> <span class="font-medium text-white">2 – 10 mm</span></div>
              <div class="flex justify-between"><span>Aplikasi:</span> <span class="font-medium text-white">Huruf Timbul & Signage</span></div>
              <div class="flex justify-between"><span>Basis Perhitungan:</span> <span class="font-medium text-white">Durasi runtime mesin</span></div>
              <div class="flex justify-between text-brand-primary font-semibold pt-1"><span>Tarif Jasa:</span> <span>Rp 4.000 / Menit</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="/harga" class="inline-flex items-center gap-2 text-brand-primary font-semibold text-sm hover:underline">
          Lihat rincian tabel harga lengkap seluruh material dan ketebalan →
        </a>
      </div>
    </div>
  </section>

  <!-- Layanan -->
  <section class="py-20 bg-brand-surface-alt">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Produk Fabrikasi Jadi</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Aplikasi Produk Laser Cutting</h2>
        <p class="text-zinc-400 mt-3">Selain jasa potong saja, kami memproduksi paket unit jadi siap pasang dengan rangka kokoh dan garansi 1 tahun</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-stagger">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- Motif Populer -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Inspirasi</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Motif Populer 2026</h2>
        <p class="text-zinc-400 mt-3">Temukan gaya yang cocok untuk rumah atau bangunan Anda</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 animate-stagger">
        {topMotifs.map((m) => (
          <a href={`/layanan/${m.serviceSlug}/motif/${m.motifSlug}`} class="group block bg-brand-surface-alt rounded-xl border border-zinc-800 overflow-hidden hover:border-brand-primary/30 hover:shadow-md transition-all no-underline">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={m.imagePath} alt={m.name} title={m.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-3 text-center">
              <h4 class="text-sm font-semibold text-white">{m.name}</h4>
              <span class="text-[10px] text-zinc-500 block">{m.category}</span>
              {m.isPopular && <span class="inline-block mt-1 text-[10px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded-full">Populer</span>}
              {m.isTrending && <span class="inline-block mt-1 text-[10px] font-semibold text-brand-primary bg-brand-primary/15 px-2 py-0.5 rounded-full">Tren 2026</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/layanan" class="inline-flex items-center gap-2 text-brand-primary font-medium text-sm hover:underline">
          Lihat semua layanan
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimoni / Keunggulan -->
  <section class="py-20 bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Mengapa Pilih Kami</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2">Lebih dari Sekadar Cutting</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 animate-stagger">
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Presisi Tinggi</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Mesin CNC laser modern dengan tolerasi hingga 0.1mm. Hasil potongan rapi, tanpa gerinda, tanpa cacat.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Motif Custom</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Bawa gambar atau foto inspirasi Anda. Tim desain kami akan mewujudkannya dalam bentuk cutting presisi.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Garansi 1 Tahun</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Setiap pekerjaan kami beri garansi penuh 1 tahun. Komitmen kualitas dari tim yang berpengalaman sejak 2008.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <CTABanner />
    </div>
  </section>

  <!-- Latest Blog -->
  <section class="py-20 bg-brand-surface-alt">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Blog & Tips</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Update Terbaru</h2>
        <p class="text-zinc-400 mt-3">Inspirasi desain dan panduan lengkap laser cutting</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 animate-stagger">
        {latestPosts.map((post) => (
          <BlogCard 
            id={post.id}
            title={post.data.title}
            excerpt={post.data.excerpt}
            imgurl={post.data.imgurl}
            imgalt={post.data.imgalt ?? ''}
            topik={post.data.topik}
            date={post.data.date}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
          Lihat Semua Artikel
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
