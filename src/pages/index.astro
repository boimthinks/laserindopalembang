---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE } from '../config/site';
import { services } from '../data/services';
import { motifs } from '../data/motifs';
import { waUrl, slugifyMotif, motifImagePath } from '../lib/utils';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);

const motifImageMap: Record<string, string> = {
  'Geometris Minimalis': '/img/motif/pagar-geometris-minimalis.webp',
  'Floral Modern': '/img/motif/pagar-floral-modern.webp',
  'Kaligrafi / Islami': '/img/motif/pagar-kaligrafi-islami.webp',
  'Hexagon / Sarang Lebah': '/img/motif/fasad-hexagon-sarang-lebah.webp',
  'Pohon Ranting': '/img/motif/pagar-pohon-ranting.webp',
  'Moroccan Pattern': '/img/motif/partisi-moroccan-pattern.webp',
  'Daun Tropis Lebar': '/img/motif/pagar-floral-modern.webp',
  'Garis Vertikal Miring': '/img/motif/railing-garis-vertikal-miring.webp',
  'Mozaik Lingkaran': '/img/motif/partisi-mozaik-lingkaran.webp',
  'Batik Nusantara': '/img/motif/partisi-batik-nusantara.webp',
};

const motifServiceMap: Record<string, string> = {
  'Geometris Minimalis': 'pagar',
  'Floral Modern': 'pagar',
  'Kaligrafi / Islami': 'pagar',
  'Hexagon / Sarang Lebah': 'fasad',
  'Pohon Ranting': 'pagar',
  'Moroccan Pattern': 'partisi',
  'Daun Tropis Lebar': 'pagar',
  'Garis Vertikal Miring': 'railing',
  'Mozaik Lingkaran': 'partisi',
  'Batik Nusantara': 'partisi',
};

const topMotifs = motifs.slice(0, 10).map((m) => ({
  ...m,
  motifSlug: slugifyMotif(m.name),
  serviceSlug: motifServiceMap[m.name] || 'pagar',
  imagePath: motifImageMap[m.name] || `/img/motif/pagar-${slugifyMotif(m.name)}.webp`,
}));
---

<BaseLayout
  title="Jasa Laser Cutting Palembang"
  description="Jasa laser cutting Palembang untuk pagar, kanopi, partisi, railing, dan fasad. Presisi tinggi, motif custom, garansi 1 tahun. Hubungi kami!"
  schemaType="LocalBusiness"
  breadcrumbs={[{ name: 'Beranda', slug: '/' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 pb-36 md:pt-60 md:pb-48 overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src="/hero_laserindo_palembang.webp" alt="" class="w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 relative">
      <div class="max-w-3xl animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white text-xs font-semibold mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
          by Sriwijaya Grafika — sejak 2008
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight uppercase" style="font-family: 'Oxanium', sans-serif">
          Laserindo <span class="text-brand-accent">Palembang</span>
        </h1>
        <p class="text-lg text-zinc-200 mt-2 max-w-xl leading-relaxed">
          Presisi tinggi untuk pagar, kanopi, partisi, railing, dan fasad bangunan Anda. Wujudkan desain impian dengan teknologi laser cutting modern.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-accent text-white font-semibold hover:bg-brand-accent-light transition-colors">
            Konsultasi Gratis
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/harga" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
            Lihat Harga
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 animate-stagger">
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.yearsExperience}+</div>
          <div class="text-xs text-zinc-400 mt-1">Tahun Pengalaman</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.projectsCompleted}+</div>
          <div class="text-xs text-zinc-400 mt-1">Proyek Selesai</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.warrantyYears} Thn</div>
          <div class="text-xs text-zinc-400 mt-1">Garansi Penuh</div>
        </div>
        <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">Free</div>
          <div class="text-xs text-zinc-400 mt-1">Konsultasi Desain</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Layanan -->
  <section class="py-20 bg-brand-surface-alt">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Layanan</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Solusi Laser Cutting Lengkap</h2>
        <p class="text-zinc-400 mt-3">Dari pagar hingga fasad, kami siap mewujudkan desain Anda</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-stagger">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- Motif Populer -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Inspirasi</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Motif Populer 2026</h2>
        <p class="text-zinc-400 mt-3">Temukan gaya yang cocok untuk rumah atau bangunan Anda</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 animate-stagger">
        {topMotifs.map((m) => (
          <a href={`/layanan/${m.serviceSlug}/motif/${m.motifSlug}`} class="group block bg-brand-surface-alt rounded-xl border border-zinc-800 overflow-hidden hover:border-brand-primary/30 hover:shadow-md transition-all no-underline">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={m.imagePath} alt={m.name} title={m.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-3 text-center">
              <h4 class="text-sm font-semibold text-white">{m.name}</h4>
              <span class="text-[10px] text-zinc-500 block">{m.category}</span>
              {m.isPopular && <span class="inline-block mt-1 text-[10px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded-full">Populer</span>}
              {m.isTrending && <span class="inline-block mt-1 text-[10px] font-semibold text-brand-primary bg-brand-primary/15 px-2 py-0.5 rounded-full">Tren 2026</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/layanan" class="inline-flex items-center gap-2 text-brand-primary font-medium text-sm hover:underline">
          Lihat semua layanan
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimoni / Keunggulan -->
  <section class="py-20 bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Mengapa Pilih Kami</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2">Lebih dari Sekadar Cutting</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 animate-stagger">
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Presisi Tinggi</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Mesin CNC laser modern dengan tolerasi hingga 0.1mm. Hasil potongan rapi, tanpa gerinda, tanpa cacat.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Motif Custom</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Bawa gambar atau foto inspirasi Anda. Tim desain kami akan mewujudkannya dalam bentuk cutting presisi.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Garansi 1 Tahun</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Setiap pekerjaan kami beri garansi penuh 1 tahun. Komitmen kualitas dari tim yang berpengalaman sejak 2008.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <CTABanner />
    </div>
  </section>

  <!-- Latest Blog -->
  <section class="py-20 bg-brand-surface-alt">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Blog & Tips</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Update Terbaru</h2>
        <p class="text-zinc-400 mt-3">Inspirasi desain dan panduan lengkap laser cutting</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 animate-stagger">
        {latestPosts.map((post) => (
          <BlogCard 
            id={post.id}
            title={post.data.title}
            excerpt={post.data.excerpt}
            imgurl={post.data.imgurl}
            imgalt={post.data.imgalt ?? ''}
            topik={post.data.topik}
            date={post.data.date}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
          Lihat Semua Artikel
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
