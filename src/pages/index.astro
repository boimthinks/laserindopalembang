---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE } from '../config/site';
import { services } from '../data/services';
import { motifs } from '../data/motifs';
import { waUrl } from '../lib/utils';
---

<BaseLayout
  title="Jasa Laser Cutting Palembang"
  description="Jasa laser cutting Palembang untuk pagar, kanopi, partisi, railing, dan fasad. Presisi tinggi, motif custom, garansi 1 tahun. Hubungi kami!"
  schemaType="LocalBusiness"
  breadcrumbs={[{ name: 'Beranda', slug: '/' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-primary/5 via-transparent to-brand-accent/5"></div>
    <div class="max-w-7xl mx-auto px-4 relative">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-semibold mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
          Bagian dari {SITE.parentBrand} — sejak 2008
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-dark leading-tight tracking-tight">
          Cutting Laser<br />
          <span class="text-brand-primary">Palembang</span>
        </h1>
        <p class="text-lg text-zinc-600 mt-4 max-w-xl leading-relaxed">
          Presisi tinggi untuk pagar, kanopi, partisi, railing, dan fasad bangunan Anda. Wujudkan desain impian dengan teknologi laser cutting modern.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-accent text-white font-semibold hover:bg-brand-accent-light transition-colors">
            Konsultasi Gratis
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/harga" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-zinc-300 text-zinc-700 font-medium hover:bg-zinc-50 transition-colors">
            Lihat Harga
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16">
        <div class="bg-white rounded-xl border border-zinc-100 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.yearsExperience}+</div>
          <div class="text-xs text-zinc-500 mt-1">Tahun Pengalaman</div>
        </div>
        <div class="bg-white rounded-xl border border-zinc-100 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.projectsCompleted}+</div>
          <div class="text-xs text-zinc-500 mt-1">Proyek Selesai</div>
        </div>
        <div class="bg-white rounded-xl border border-zinc-100 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">{SITE.stats.warrantyYear} Thn</div>
          <div class="text-xs text-zinc-500 mt-1">Garansi Penuh</div>
        </div>
        <div class="bg-white rounded-xl border border-zinc-100 p-5 text-center">
          <div class="text-2xl font-bold text-brand-primary">Free</div>
          <div class="text-xs text-zinc-500 mt-1">Konsultasi Desain</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Layanan -->
  <section class="py-20 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Layanan</span>
        <h2 class="text-3xl md:text-4xl font-bold text-brand-dark mt-2">Solusi Laser Cutting Lengkap</h2>
        <p class="text-zinc-500 mt-3">Dari pagar hingga fasad, kami siap mewujudkan desain Anda</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <a href={`/layanan/${s.slug}`} class="group bg-white rounded-xl border border-zinc-100 p-6 hover:border-brand-primary/20 hover:shadow-lg transition-all no-underline">
            <span class="text-3xl mb-3 block">{s.slug === 'pagar' ? '🚧' : s.slug === 'kanopi' ? '🏠' : s.slug === 'partisi' ? '🚪' : s.slug === 'railing' ? '📐' : '🏛️'}</span>
            <h3 class="text-lg font-semibold text-brand-dark group-hover:text-brand-primary transition-colors">{s.title}</h3>
            <p class="text-sm text-zinc-500 mt-2 leading-relaxed">{s.description}</p>
            <div class="mt-4 text-brand-accent text-sm font-medium">{s.priceRange}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Motif Populer -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Inspirasi</span>
        <h2 class="text-3xl md:text-4xl font-bold text-brand-dark mt-2">Motif Populer 2026</h2>
        <p class="text-zinc-500 mt-3">Temukan gaya yang cocok untuk rumah atau bangunan Anda</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        {motifs.slice(0, 10).map((m) => (
          <div class="bg-white rounded-xl border border-zinc-100 p-4 text-center hover:border-brand-primary/20 hover:shadow-md transition-all">
            <span class="text-3xl block mb-2">{m.icon}</span>
            <h4 class="text-sm font-semibold text-brand-dark">{m.name}</h4>
            <span class="text-[10px] text-zinc-400 mt-1 block">{m.category}</span>
            {m.isPopular && <span class="inline-block mt-2 text-[10px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded-full">Populer</span>}
            {m.isTrending && <span class="inline-block mt-2 text-[10px] font-semibold text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded-full">Tren 2026</span>}
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/portfolio" class="inline-flex items-center gap-2 text-brand-primary font-medium text-sm hover:underline">
          Lihat semua 15+ motif
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimoni / Keunggulan -->
  <section class="py-20 bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Mengapa Pilih Kami</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2">Lebih dari Sekadar Cutting</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Presisi Tinggi</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Mesin CNC laser modern dengan tolerasi hingga 0.1mm. Hasil potongan rapi, tanpa gerinda, tanpa cacat.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Motif Custom</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Bawa gambar atau foto inspirasi Anda. Tim desain kami akan mewujudkannya dalam bentuk cutting presisi.</p>
        </div>
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Garansi 1 Tahun</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Setiap pekerjaan kami beri garansi penuh 1 tahun. Komitmen kualitas dari tim yang berpengalaman sejak 2008.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <CTABanner />
    </div>
  </section>
</BaseLayout>
