---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const blogEntries = await getCollection('blog');
const posts = blogEntries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = [...new Set(posts.map((p) => p.data.topik))];
---

<BaseLayout
  title="Blog & Tips Laser Cutting"
  description="Blog jasa laser cutting Palembang. Inspirasi desain pagar, kanopi, partisi, tips perawatan, dan tren terbaru 2026."
  breadcrumbs={[{ name: 'Beranda', slug: '/' }, { name: 'Blog', slug: '/blog' }]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-white">Blog & Tips</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">Inspirasi desain, panduan harga, tips perawatan, dan tren laser cutting terbaru.</p>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-wrap gap-2 mb-10">
        <button class="px-4 py-2 rounded-lg  bg-brand-primary text-white text-sm font-medium blog-filter active" data-cat="all">semua</button>
        {categories.map((cat) => (
          <button class="px-4 py-2 rounded-lg bg-brand-surface-alt text-zinc-400 text-sm font-medium blog-filter hover:bg-zinc-800 transition-colors" data-cat={cat}>{cat}</button>
        ))}
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-stagger" id="blog-grid">
        {posts.map((post) => (
          <BlogCard 
            id={post.id}
            title={post.data.title}
            excerpt={post.data.excerpt}
            imgurl={post.data.imgurl}
            imgalt={post.data.imgalt ?? ''}
            topik={post.data.topik}
            date={post.data.date}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.blog-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.blog-filter').forEach((b) => {
        b.className = b.className.replace(' bg-brand-primary text-white', ' bg-brand-surface-alt text-zinc-400');
        b.classList.remove('active');
      });
      btn.className = btn.className.replace(' bg-brand-surface-alt text-zinc-400', ' bg-brand-primary text-white');
      btn.classList.add('active');
      const cat = (btn as HTMLElement).dataset.cat;
      document.querySelectorAll('.blog-card').forEach((card) => {
        if (cat === 'all' || (card as HTMLElement).dataset.cat === cat) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
