---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Tentang Cutting Laser Palembang"
  description="Bagian dari Sriwijaya Grafika, cutting laser Palembang melayani pemotongan presisi untuk pagar, kanopi, partisi, railing, dan fasad sejak 2008."
  breadcrumbs={[{ name: 'Beranda', slug: '/' }, { name: 'Tentang', slug: '/tentang' }]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-white">Tentang Kami</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">
          {SITE.name} adalah spesialisasi laser cutting dari {SITE.parentBrand} — perusahaan advertising dan percetakan terpercaya di Palembang sejak 2008.
        </p>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div class="space-y-8">
          <section>
            <h2 class="text-xl font-bold text-white mb-4">Sejarah & Filosofi</h2>
            <p class="text-zinc-400 leading-relaxed">
              {SITE.brandNarrative.history}
            </p>
            <p class="text-zinc-400 leading-relaxed mt-4">
              Owner kami, <span class="text-white font-medium">{SITE.owner}</span>, membangun bisnis ini dari nol sebagai percetakan biasa hingga berkembang menjadi vendor advertising kelas kakap di Palembang. Pengalaman belasan tahun mengajarkan kami bahwa kualitas adalah mata uang utama.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-white mb-4">Komitmen Sosial</h2>
            <div class="bg-brand-primary/5 border-l-4 border-brand-primary p-6 rounded-r-xl">
                <p class="text-zinc-300 italic leading-relaxed">
                    "{SITE.brandNarrative.commitment}"
                </p>
            </div>
            <p class="text-sm text-zinc-500 mt-3">
              Kami percaya bahwa bisnis yang baik bukan hanya tentang profit, tapi juga memberikan manfaat nyata bagi masyarakat sekitar workshop kami di Talang Jambe.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-white mb-4">Klien Korporat</h2>
            <div class="flex flex-wrap gap-2">
                {SITE.majorClients.map((client) => (
                    <span class="px-3 py-1.5 bg-brand-surface-alt border border-zinc-800 rounded-lg text-xs text-zinc-400">
                        {client}
                    </span>
                ))}
            </div>
          </section>

        <div class="space-y-6">
          <div class="bg-brand-dark text-white rounded-xl p-8">
            <h3 class="text-lg font-bold mb-4">Kenapa Pilih Kami?</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class="text-3xl font-bold text-brand-accent">{SITE.stats.yearsExperience}+</div>
                <div class="text-sm text-zinc-300">Tahun pengalaman di industri signage & cutting</div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-3xl font-bold text-brand-accent">{SITE.stats.projectsCompleted}+</div>
                <div class="text-sm text-zinc-300">Proyek selesai untuk berbagai klien</div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-3xl font-bold text-brand-accent">{SITE.stats.warrantyYears}</div>
                <div class="text-sm text-zinc-300">Tahun garansi penuh untuk setiap pekerjaan</div>
              </div>
            </div>
          </div>

          <div class="bg-brand-surface-alt rounded-xl p-6 border border-zinc-800">
            <h3 class="font-semibold text-white mb-3">Lokasi Workshop</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">{SITE.address.full}</p>
            <a href={SITE.address.mapsUrl} target="_blank" rel="noopener" class="inline-block mt-3 text-brand-primary font-medium text-sm hover:underline">
              Lihat di Google Maps →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-16">
    <div class="max-w-7xl mx-auto px-4">
      <CTABanner />
    </div>
  </div>
</BaseLayout>
