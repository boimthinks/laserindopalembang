---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTABanner from '../../../../components/CTABanner.astro';
import { SITE } from '../../../../config/site';
import { waUrl, formatPrice } from '../../../../lib/utils';
import { services } from '../../../../data/services';
import { serviceMotifs } from '../../../../data/serviceMotifs';

export async function getStaticPaths() {
  return serviceMotifs.map((m) => ({
    params: { service: m.serviceSlug, motif: m.slug },
    props: { motif: m },
  }));
}

const { motif } = Astro.props;
const service = services.find((s) => s.slug === motif.serviceSlug)!;
const relatedMotifs = serviceMotifs.filter((m) => m.serviceSlug === motif.serviceSlug && m.slug !== motif.slug);
const siteUrl = Astro.site?.toString() || `https://laserindopalembang.com`;
const ogImage = `${siteUrl}${motif.image}`;
const waText = `Halo%2C%20saya%20tertarik%20dengan%20motif%20${encodeURIComponent(motif.name)}%20untuk%20${encodeURIComponent(service.title)}`;
---

<BaseLayout
  title={`${service.shortTitle} Laser Cutting Motif ${motif.name}`}
  description={motif.description}
  ogImage={ogImage}
  schemaType="Product"
  schemaData={{ name: `Motif ${motif.name} untuk ${service.title}`, description: motif.description, image: `${siteUrl}${motif.image}`, price: formatPrice(service.priceMin), currency: 'IDR' }}
  showLocalBusiness={true}
  breadcrumbs={[
    { name: 'Beranda', slug: '/' },
    { name: 'Layanan', slug: '/layanan' },
    { name: service.title, slug: `/layanan/${service.slug}` },
    { name: `Motif ${motif.name}`, slug: `/layanan/${service.slug}/motif/${motif.slug}` },
  ]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={motif.image} alt={motif.seoTitle} title={motif.seoTitle} class="w-full h-full object-cover opacity-20" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-surface-alt via-brand-surface-alt/95 to-brand-surface-alt/80"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold text-brand-accent uppercase tracking-widest">Motif {service.shortTitle}</span>
        <h1 class="text-3xl md:text-4xl font-bold text-white mt-2">{service.shortTitle} Laser Cutting Motif {motif.name}</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">{motif.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={waUrl(SITE.contact.whatsapp, waText)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-accent text-white font-medium text-sm hover:bg-brand-accent-light transition-colors">
            Tanya via WhatsApp
          </a>
          <a href={`/layanan/${service.slug}`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-surface border border-zinc-700 text-zinc-300 text-sm font-medium hover:text-white transition-colors no-underline">
            Lihat {service.shortTitle}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-10">
          <section>
            <div class="rounded-xl overflow-hidden border border-zinc-800">
              <img src={motif.image} alt={motif.seoTitle} title={motif.seoTitle} class="w-full aspect-[4/3] object-cover" loading="eager" />
            </div>
          </section>

          <section>
            <h2 class="text-xl font-bold text-white mb-4">Tentang Motif {motif.name}</h2>
            <p class="text-sm text-zinc-400 leading-relaxed">{motif.description}</p>
            <p class="text-sm text-zinc-400 leading-relaxed mt-4">Kami menggunakan mesin CNC laser presisi tinggi untuk memotong motif {motif.name.toLowerCase()} pada {service.title.toLowerCase()}. Hasil potongan rapi, bersih, dan siap dipasang. Tersedia dalam berbagai ukuran dan material sesuai kebutuhan Anda.</p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-white mb-4">Harga {service.shortTitle} Motif {motif.name}</h2>
            <div class="bg-brand-surface-alt rounded-xl p-6 border border-zinc-800">
              <p class="text-sm text-zinc-400">Kisaran harga untuk {service.shortTitle.toLowerCase()} motif {motif.name.toLowerCase()} di Palembang:</p>
              <div class="mt-3 text-2xl font-bold text-brand-primary">{formatPrice(service.priceMin)} - {formatPrice(service.priceMax)}</div>
              <p class="text-xs text-zinc-500 mt-1">Harga tergantung ukuran, material, dan kerumitan motif</p>
            </div>
            <div class="mt-4">
              <a href={waUrl(SITE.contact.whatsapp, waText)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-accent text-white font-medium text-sm hover:bg-brand-accent-light transition-colors">
                Pesan Motif {motif.name} via WhatsApp
              </a>
            </div>
          </section>
        </div>

        <div class="space-y-4">
          <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6 sticky top-24">
            <h3 class="font-semibold text-white mb-3">Motif {service.shortTitle} Lainnya</h3>
            <div class="space-y-2">
              {relatedMotifs.map((m) => (
                <a href={`/layanan/${service.slug}/motif/${m.slug}`} class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50 hover:text-brand-primary transition-colors no-underline">
                  {m.name}
                </a>
              ))}
            </div>
            <div class="mt-4 pt-4 border-t border-zinc-800">
              <a href={`/layanan/${service.slug}`} class="block text-sm text-brand-accent hover:underline no-underline">← Kembali ke {service.shortTitle}</a>
            </div>
            <div class="mt-4">
              <a href={waUrl(SITE.contact.whatsapp, waText)} target="_blank" rel="noopener" class="block w-full text-center px-4 py-3 rounded-lg bg-brand-accent text-white font-medium text-sm hover:bg-brand-accent-light transition-colors">
                Konsultasi Gratis
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-16">
    <div class="max-w-7xl mx-auto px-4">
      <CTABanner />
    </div>
  </div>
</BaseLayout>
