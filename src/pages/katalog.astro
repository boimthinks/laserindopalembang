--- 
import BaseLayout from '../layouts/BaseLayout.astro';
import KatalogGallery from '../components/KatalogGallery';
import { getCollection } from 'astro:content';

const katalogData = await getCollection('katalog');
const { downloadPassword, items } = katalogData[0].data;
---

<BaseLayout
  title="Katalog Desain Laser Cutting"
  description="Katalog desain laser cutting untuk pagar, kanopi, partisi, railing, fasad, dan plat nama. Download file desain untuk tim produksi."
  breadcrumbs={[
    { name: 'Beranda', slug: '/' },
    { name: 'Katalog', slug: '/katalog' }
  ]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-white">Katalog Desain</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">
          Koleksi desain laser cutting siap produksi. Klik gambar untuk melihat detail dan download file desain.
        </p>
      </div>
    </div>
  </div>

  <KatalogGallery items={items} password={downloadPassword} client:load />
</BaseLayout>