---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { waUrl } from '../lib/utils';
---

<BaseLayout
  title="Kontak Cutting Laser Palembang"
  description="Hubungi Cutting Laser Palembang untuk konsultasi gratis. WhatsApp, telepon, email, atau datang langsung ke workshop kami di Talang Jambe, Sukarami."
  schemaType="LocalBusiness"
  breadcrumbs={[{ name: 'Beranda', slug: '/' }, { name: 'Kontak', slug: '/kontak' }]}
>
  <div class="pt-36 pb-20 bg-brand-surface-alt border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-white">Hubungi Kami</h1>
        <p class="text-zinc-400 mt-3 leading-relaxed">
          Siap mewujudkan desain impian? Konsultasi gratis via WhatsApp atau datang langsung ke workshop kami.
        </p>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-accent/10 flex items-center justify-center shrink-0">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-brand-accent"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">WhatsApp</h3>
                <p class="text-sm text-zinc-400 mt-1">Respon cepat, konsultasi gratis</p>
                <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="inline-block mt-2 text-brand-accent font-medium text-sm hover:underline">{SITE.contact.phone}</a>
              </div>
            </div>

            <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-primary"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Alamat</h3>
                <p class="text-sm text-zinc-400 mt-1 leading-relaxed">{SITE.address.full}</p>
                <a href={SITE.address.mapsUrl} target="_blank" rel="noopener" class="inline-block mt-2 text-brand-primary font-medium text-sm hover:underline">Lihat di Google Maps →</a>
              </div>
            </div>

            <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-accent/10 flex items-center justify-center shrink-0">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-accent"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Email</h3>
                <a href={`mailto:${SITE.contact.email}`} class="text-sm text-brand-accent font-medium hover:underline">{SITE.contact.email}</a>
              </div>
            </div>

            <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-primary"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Jam Operasional</h3>
                <p class="text-sm text-zinc-400 mt-1">Senin - Jumat: 08:00 - 17:00</p>
                <p class="text-sm text-zinc-400">Sabtu: 08:00 - 14:00</p>
              </div>
            </div>

            <div class="bg-brand-surface-alt rounded-xl border border-zinc-800 p-6">
              <h3 class="font-semibold text-white mb-3">Ikuti Kami</h3>
              <div class="flex gap-3">
                <a href={SITE.social.instagram} target="_blank" rel="noopener" class="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white text-sm font-medium hover:opacity-90 transition-opacity">
                  Instagram
                </a>
                <a href={SITE.social.facebook} target="_blank" rel="noopener" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:opacity-90 transition-opacity">
                  Facebook
                </a>
                <a href={SITE.social.pinterest} target="_blank" rel="noopener" class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium hover:opacity-90 transition-opacity">
                  Pinterest
                </a>
              </div>
            </div>
          </div>

          <div class="rounded-xl overflow-hidden border border-zinc-800 h-[500px]">
          <iframe src={SITE.address.mapsUrl.replace('https://maps.google.com/?q=', 'https://maps.google.com/maps?q=') + '&output=embed'} width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
