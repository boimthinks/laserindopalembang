---
import BaseLayout from '../layouts/BaseLayout.astro';
import SVGWorkspace from '../components/svg-builder/SVGWorkspace';
---

<BaseLayout
  title="Interactive SVG Builder"
  description="Rancang motif laser cutting custom Anda sendiri. Pilih motif, atur ukuran, dan dapatkan estimasi harga langsung."
