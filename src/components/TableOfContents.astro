---
const { headings } = Astro.props;
---

<div class="bg-brand-surface-alt rounded-2xl border border-zinc-800 p-6">
  <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    Daftar Isi
  </h3>
  <nav class="space-y-1">
    {headings.map((heading: any) => (
      <a 
        href={`#${heading.slug}`}
        class="block text-sm text-zinc-400 hover:text-brand-primary transition-colors py-1 leading-relaxed"
      >
        {heading.text}
      </a>
    ))}
  </nav>
</div>
