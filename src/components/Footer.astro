---
import { SITE } from '../config/site';
import { waUrl } from '../lib/utils';
---

<footer class="bg-brand-dark text-zinc-300">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <div class="flex items-center gap-2 mb-4">
        <span class="w-8 h-8 rounded-lg bg-brand-accent flex items-center justify-center text-white text-sm font-bold">CL</span>
        <span class="text-white font-bold text-sm">{SITE.shortName}</span>
      </div>
      <p class="text-sm text-zinc-400 leading-relaxed">{SITE.tagline}</p>
      <div class="flex gap-3 mt-4">
        <a href={SITE.social.instagram} target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-brand-accent transition-colors" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-brand-accent transition-colors" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={SITE.social.pinterest} target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-brand-accent transition-colors" aria-label="Pinterest">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.403.042-3.438.218-.932 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.38l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h4 class="text-white text-sm font-semibold mb-4">Layanan</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/layanan/pagar" class="hover:text-white transition-colors no-underline">Pagar Laser Cutting</a></li>
        <li><a href="/layanan/kanopi" class="hover:text-white transition-colors no-underline">Kanopi Laser Cutting</a></li>
        <li><a href="/layanan/partisi" class="hover:text-white transition-colors no-underline">Partisi & Dinding</a></li>
        <li><a href="/layanan/railing" class="hover:text-white transition-colors no-underline">Railing Tangga</a></li>
        <li><a href="/layanan/fasad" class="hover:text-white transition-colors no-underline">Fasad Bangunan</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm font-semibold mb-4">Material</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/material/besi" class="hover:text-white transition-colors no-underline">Cutting Besi</a></li>
        <li><a href="/material/stainless" class="hover:text-white transition-colors no-underline">Cutting Stainless</a></li>
        <li><a href="/material/akrilik" class="hover:text-white transition-colors no-underline">Cutting Akrilik</a></li>
        <li><a href="/material/kayu-mdf" class="hover:text-white transition-colors no-underline">Cutting Kayu & MDF</a></li>
        <li><a href="/material/acp-pvc" class="hover:text-white transition-colors no-underline">Cutting ACP & PVC</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm font-semibold mb-4">Kontak</h4>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="flex items-start gap-2 hover:text-white transition-colors no-underline">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12 0C5.373 0 0 5.373 0 12c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654A11.882 11.882 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            <span>{SITE.contact.phone}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.contact.email}`} class="flex items-start gap-2 hover:text-white transition-colors no-underline">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>{SITE.contact.email}</span>
          </a>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="text-xs">{SITE.address.full}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-zinc-500">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. Bagian dari {SITE.parentBrand}.</p>
      <p>Talang Jambe, Sukarami, Palembang</p>
    </div>
  </div>
</footer>
