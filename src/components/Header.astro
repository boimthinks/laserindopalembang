---
import { SITE } from '../config/site';
import { waUrl } from '../lib/utils';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-brand-surface/90 backdrop-blur-md border-b border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 no-underline">
      <span class="w-8 h-8 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1455 1682" class="w-full h-full" aria-label="Laserindo Palembang">
          <path fill-rule="evenodd" fill="#fff" d="M1426.649,997.500 C1393.769,1110.196 1293.161,1205.856 1293.161,1205.856 L1199.598,1111.035 L1266.967,1034.929 L1122.252,1032.434 L746.752,615.722 L1002.493,19.350 C1002.493,19.350 1131.393,39.098 1251.997,71.751 C1355.952,99.896 1454.094,141.619 1454.094,141.619 L1454.094,766.686 C1454.094,766.686 1457.979,890.116 1426.649,997.500 ZM602.040,238.934 L557.129,358.708 L491.011,127.894 L508.476,369.937 L212.814,68.008 C212.814,68.008 363.534,28.274 492.258,13.112 C642.548,-4.591 774.197,1.883 774.197,1.883 L594.555,422.338 L602.040,238.934 ZM880.236,1032.434 L562.119,1032.434 L655.683,817.839 L880.236,1032.434 ZM207.824,557.083 L391.209,604.493 L149.191,718.028 L148.890,718.332 L416.160,644.418 L237.765,837.802 L496.001,644.418 L310.121,1074.853 C310.121,1074.853 285.356,1147.346 322.596,1198.370 C353.522,1240.743 417.407,1244.532 417.407,1244.532 L1104.789,1244.532 L1212.076,1345.591 C1212.076,1345.591 1111.892,1448.334 993.760,1530.242 C870.004,1616.050 728.039,1681.206 728.039,1681.206 C728.039,1681.206 411.762,1535.371 230.280,1334.363 C16.661,1097.760 2.938,890.851 2.058,866.422 L1.984,866.497 L0.736,194.019 L387.518,553.340 L207.824,557.083 Z"/>
          <path fill-rule="evenodd" fill="#f97316" d="M29.460,149.583 C43.527,141.061 64.199,128.816 84.342,117.913 C107.189,105.546 134.238,94.557 148.326,89.106 L1273.343,1274.476 L29.460,149.583 Z"/>
        </svg>
      </span>
      <div>
        <span class="text-base font-bold text-white block leading-tight uppercase tracking-wider" style="font-family: 'Oxanium', sans-serif">Laserindo</span>
        <span class="text-[11px] font-bold text-white block leading-tight uppercase tracking-widest" style="font-family: 'Oxanium', sans-serif">Palembang</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      <a href="/" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">Beranda</a>
      <a href="/layanan" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">Layanan</a>
      <a href="/harga" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">Harga</a>
      <a href="/blog" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">Blog</a>
      <a href="/faq" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">FAQ</a>
      <a href="/kontak" class="px-3 py-2 text-sm text-zinc-400 rounded-lg hover:text-brand-primary hover:bg-zinc-800/50 transition-colors no-underline">Kontak</a>
    </nav>

    <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-accent text-white text-sm font-medium hover:bg-brand-accent-light transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>{SITE.contact.phone}</span>
    </a>

    <button class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg hover:bg-zinc-800 text-zinc-400" aria-label="Menu" id="menu-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden border-t border-zinc-800 bg-brand-surface px-4 py-3 space-y-1">
    <a href="/" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">Beranda</a>
    <a href="/layanan" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">Layanan</a>
    <a href="/harga" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">Harga</a>
    <a href="/blog" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">Blog</a>
    <a href="/faq" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">FAQ</a>
    <a href="/kontak" class="block px-3 py-2 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800/50">Kontak</a>
    <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-brand-accent text-white text-sm font-medium mt-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>{SITE.contact.phone}</span>
    </a>
  </nav>
</header>

<script>
  document.getElementById('menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
