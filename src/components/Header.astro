---
import { SITE } from '../config/site';
import { waUrl } from '../lib/utils';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-zinc-100">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 no-underline">
      <span class="w-8 h-8 rounded-lg bg-brand-primary flex items-center justify-center text-white text-sm font-bold">CL</span>
      <div>
        <span class="text-sm font-bold text-brand-dark block leading-tight">{SITE.shortName}</span>
        <span class="text-[10px] text-zinc-400 block leading-tight">{SITE.parentBrand}</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      <a href="/" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Beranda</a>
      <a href="/layanan/pagar" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Layanan</a>
      <a href="/harga" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Harga</a>
      <a href="/portfolio" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Portfolio</a>
      <a href="/builder" class="px-3 py-2 text-sm text-orange-600 rounded-lg hover:bg-orange-50 transition-colors no-underline font-medium">Builder</a>
      <a href="/blog" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Blog</a>
      <a href="/faq" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">FAQ</a>
      <a href="/kontak" class="px-3 py-2 text-sm text-zinc-600 rounded-lg hover:text-brand-primary hover:bg-zinc-50 transition-colors no-underline">Kontak</a>
    </nav>

    <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-accent text-white text-sm font-medium hover:bg-brand-accent-light transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>{SITE.contact.phone}</span>
    </a>

    <button class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg hover:bg-zinc-100" aria-label="Menu" id="menu-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden border-t border-zinc-100 bg-white px-4 py-3 space-y-1">
    <a href="/" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Beranda</a>
    <a href="/layanan/pagar" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Layanan</a>
    <a href="/harga" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Harga</a>
    <a href="/portfolio" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Portfolio</a>
    <a href="/builder" class="block px-3 py-2 rounded-lg text-sm text-orange-600 font-medium hover:bg-orange-50">Builder</a>
    <a href="/blog" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Blog</a>
    <a href="/faq" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">FAQ</a>
    <a href="/kontak" class="block px-3 py-2 rounded-lg text-sm hover:bg-zinc-50">Kontak</a>
    <a href={waUrl(SITE.contact.whatsapp)} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-brand-accent text-white text-sm font-medium mt-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>{SITE.contact.phone}</span>
    </a>
  </nav>
</header>

<script>
  document.getElementById('menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
