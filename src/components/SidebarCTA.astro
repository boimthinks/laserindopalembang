---
import { SITE } from '../config/site';
import { waUrl } from '../lib/utils';
---

<div class="bg-brand-surface-alt rounded-2xl border border-zinc-800 p-6 overflow-hidden relative group">
  <div class="absolute -top-12 -right-12 w-24 h-24 bg-brand-primary/10 rounded-full blur-2xl group-hover:bg-brand-primary/20 transition-colors"></div>
  
  <h3 class="text-white font-bold text-lg leading-snug mb-3 relative">Butuh Konsultasi Laser Cutting?</h3>
  <p class="text-zinc-400 text-sm mb-6 relative">Dapatkan estimasi biaya dan mockup 3D gratis untuk proyek Anda.</p>
  
  <div class="space-y-3 relative">
    <a 
      href={waUrl(SITE.contact.whatsapp)} 
      target="_blank" 
      rel="noopener" 
      class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-brand-primary text-white font-bold text-sm hover:bg-brand-primary-light transition-colors shadow-lg shadow-brand-primary/20"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      Chat WhatsApp
    </a>
  </div>
</div>
